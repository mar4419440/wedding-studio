// Prisma schema — Bilingual Wedding Platform
// PostgreSQL via Supabase

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "mysql"
  url       = env("DATABASE_URL")
}

model Family {
  id          String    @id @default(uuid())
  nameAr      String
  nameEn      String
  phone       String?
  guestCount  Int       @default(1)
  rsvpStatus  String    @default("PENDING") // PENDING | CONFIRMED | DECLINED
  checkedIn   Boolean   @default(false)
  checkedInAt DateTime?
  qrCodeData  String?
  inviteUrl   String?  @db.VarChar(512)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([rsvpStatus])
  @@index([checkedIn])
}

model Setting {
  key   String @id
  value String @db.Text
}

model Media {
  id        String   @id @default(uuid())
  kind      String   @default("gallery") // gallery | story
  url       String   @db.VarChar(512)
  mediaType String   @default("image") // image | video
  captionAr String?  @db.Text
  captionEn String?  @db.Text
  titleAr   String?
  titleEn   String?
  bodyAr    String?  @db.Text
  bodyEn    String?  @db.Text
  dateLabel String?
  eventTag  String?  // engagement | henna | wedding | other
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([kind, order])
}
