// Prisma schema — Bilingual Wedding Platform
// PostgreSQL via Supabase

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model Family {
  id          String    @id @default(uuid())
  nameAr      String
  nameEn      String
  phone       String?
  guestCount  Int       @default(1)
  rsvpStatus  String    @default("PENDING") // PENDING | CONFIRMED | DECLINED
  checkedIn   Boolean   @default(false)
  checkedInAt DateTime?
  qrCodeData  String?
  inviteUrl   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([rsvpStatus])
  @@index([checkedIn])
}

model Setting {
  key   String @id
  value String
}

model Media {
  id        String   @id @default(uuid())
  kind      String   @default("gallery") // gallery | story
  url       String
  mediaType String   @default("image") // image | video
  captionAr String?
  captionEn String?
  titleAr   String?
  titleEn   String?
  bodyAr    String?
  bodyEn    String?
  dateLabel String?
  eventTag  String?  // engagement | henna | wedding | other
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([kind, order])
}
